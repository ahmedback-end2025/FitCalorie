@{
    ViewData["Title"] = "Welcome to FitCalorie";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="display-4 fw-bold mb-3" style="color: #1e3c72;">FitCalorie Tracker</h1>
            <p class="lead text-muted mb-4">
                Track your daily calories, monitor your macronutrients (Protein, Carbs, Fats), and reach your fitness goals with ease.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 rounded-3 shadow-sm" style="background: linear-gradient(135deg, #2575fc 0%, #6a11cb 100%); border: none;">
                    Sign In
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4 rounded-3 shadow-sm">
                    Create Account
                </a>
            </div>
        </div>
    </div>
</div>
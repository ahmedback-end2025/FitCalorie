@model FitCalorie.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Index";
}

<div class="container my-4">
    <!-- Header with Action Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Today's Summary</h2>
            <p class="text-muted mb-0">Track your daily intake and macros progress</p>
        </div>
        <a asp-controller="DailyLogs" asp-action="LogMeal" class="btn text-white px-4 py-2 rounded-3 shadow-sm" style="background: linear-gradient(135deg, #2575fc 0%, #6a11cb 100%);">
            + Log New Meal
        </a>
    </div>

    <!-- 4 Progress Cards -->
    <div class="row g-3 mb-4">
        <!-- Calories Card -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-secondary">🔥 Calories</span>
                    <span class="badge bg-primary-subtle text-primary fw-bold">@Model.CaloriesPercent%</span>
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.TotalCalories <small class="text-muted fs-6">/ @Model.TargetCalories kcal</small></h4>
                <div class="progress mt-2" style="height: 8px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.CaloriesPercent%"></div>
                </div>
            </div>
        </div>

        <!-- Protein Card -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-secondary">🍗 Protein</span>
                    <span class="badge bg-danger-subtle text-danger fw-bold">@Model.ProteinPercent%</span>
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.TotalProtein g <small class="text-muted fs-6">/ @Model.TargetProtein g</small></h4>
                <div class="progress mt-2" style="height: 8px;">
                    <div class="progress-bar bg-danger" role="progressbar" style="width: @Model.ProteinPercent%"></div>
                </div>
            </div>
        </div>

        <!-- Carbs Card -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-secondary">🍚 Carbs</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis fw-bold">@Model.CarbsPercent%</span>
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.TotalCarbs g <small class="text-muted fs-6">/ @Model.TargetCarbs g</small></h4>
                <div class="progress mt-2" style="height: 8px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: @Model.CarbsPercent%"></div>
                </div>
            </div>
        </div>

        <!-- Fats Card -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-secondary">🥑 Fats</span>
                    <span class="badge bg-success-subtle text-success fw-bold">@Model.FatsPercent%</span>
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.TotalFats g <small class="text-muted fs-6">/ @Model.TargetFats g</small></h4>
                <div class="progress mt-2" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.FatsPercent%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Meals Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-dark">Today's Meals</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Food Item</th>
                        <th>Amount</th>
                        <th>Calories</th>
                        <th>Protein</th>
                        <th>Carbs</th>
                        <th>Fats</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LoggedMeals.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No meals logged today yet. Click "+ Log New Meal" to begin!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var meal in Model.LoggedMeals)
                        {
                            <tr>
                                <td class="fw-semibold">@meal.FoodName</td>
                                <td>@meal.AmountGrams g</td>
                                <td><span class="badge bg-primary-subtle text-primary">@meal.Calories kcal</span></td>
                                <td>@meal.Protein g</td>
                                <td>@meal.Carbs g</td>
                                <td>@meal.Fats g</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model FitCalorie.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="container mt-5 mb-5" style="max-width: 650px;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Header with matching gradient -->
        <div class="card-header py-4 text-white text-center" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
            <h4 class="mb-1 fw-bold">Create FitCalorie Account</h4>
            <p class="mb-0 text-white-50 small">Start your fitness journey with us today</p>
        </div>

        <div class="card-body p-4 p-md-5 bg-white">

            <!-- Server-Side Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm py-2 small" role="alert"></div>

            <form asp-action="SaveRegister" method="post">
                @Html.AntiForgeryToken()

                <!-- Name Input -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-secondary">Full Name</label>
                    <input asp-for="Name" class="form-control form-control-lg shadow-none" placeholder="Ahmed Mohamed" style="border-radius: 8px;" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Email Input -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control form-control-lg shadow-none" placeholder="name@example.com" style="border-radius: 8px;" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Password Row -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-secondary">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg shadow-none" placeholder="••••••••" style="border-radius: 8px;" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg shadow-none" placeholder="••••••••" style="border-radius: 8px;" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Metrics Row (Age, Height, Weight) -->
                <div class="row">
                    <div class="col-4 mb-3">
                        <label asp-for="Age" class="form-label fw-semibold text-secondary">Age</label>
                        <input asp-for="Age" type="number" class="form-control form-control-lg shadow-none" placeholder="20" min="10" max="100" style="border-radius: 8px;" />
                        <span asp-validation-for="Age" class="text-danger small"></span>
                    </div>
                    <div class="col-4 mb-3">
                        <label asp-for="Height" class="form-label fw-semibold text-secondary">Height <span class="text-muted small">(cm)</span></label>
                        <input asp-for="Height" type="number" step="0.1" class="form-control form-control-lg shadow-none" placeholder="175" min="100" max="250" style="border-radius: 8px;" />
                        <span asp-validation-for="Height" class="text-danger small"></span>
                    </div>
                    <div class="col-4 mb-3">
                        <label asp-for="Weight" class="form-label fw-semibold text-secondary">Weight <span class="text-muted small">(kg)</span></label>
                        <input asp-for="Weight" type="number" step="0.1" class="form-control form-control-lg shadow-none" placeholder="70" min="30" max="300" style="border-radius: 8px;" />
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Options Row (Gender & Fitness Goal) -->
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="Gender" class="form-label fw-semibold text-secondary">Gender</label>
                        <select asp-for="Gender" class="form-select form-select-lg shadow-none" style="border-radius: 8px;">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label asp-for="FitnessGoal" class="form-label fw-semibold text-secondary">Fitness Goal</label>
                        <select asp-for="FitnessGoal" class="form-select form-select-lg shadow-none" style="border-radius: 8px;">
                            <option value="">-- Select Goal --</option>
                            <option value="Cutting">Cutting</option>
                            <option value="Bulking">Bulking</option>
                        </select>
                        <span asp-validation-for="FitnessGoal" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-lg w-100 py-3 fw-bold text-white shadow-sm" style="background: linear-gradient(135deg, #2575fc 0%, #6a11cb 100%); border: none; border-radius: 8px; font-size: 1.1rem;">
                    Register Now
                </button>

                <!-- Login Redirect Link -->
                <div class="text-center mt-4">
                    <span class="text-muted">Already have an account?</span>
                    <a asp-action="Login" asp-controller="Account" class="fw-bold text-decoration-none" style="color: #2575fc;">Sign In</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}